+ local function cross(a,b,c)return(b[1]-a[1])*(c[2]-a[2])-(b[2]-a[2])*(c[1]-a[1])end
+ local hull={};for _,p in ipairs(points)do while #hull>1 and cross(hull[#hull-1],hull[#hull],p)<=0 do table.remove(hull)end;hull[#hull+1]=p end
