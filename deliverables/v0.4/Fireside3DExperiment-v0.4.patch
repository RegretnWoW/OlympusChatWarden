+ local d,e,f=y1-y0+g*y1,y2-y0+h*y2,y0
+ local view=frame.firesideViewShot or shot;local eye,target=view.position,view.target
+ local fx,fy,fz=target[1]-eye[1],target[2]-eye[2],target[3]-eye[3]
