+-- Experimental namespace ONLY. The production renderer and vendored source stay unchanged.
+local _,ns=...
+local N,C=ns.WardenNativeScene,ns.WardenSceneObjectControls
+local W={VERSION=1,FLOOR_Z=0};ns.ExperimentWorldSpace=W
+local fixedBasis={position={0,-1,1},target={0,0,0}}
+-- Eliminate the authored-shot coordinate basis. Camera rotation is never an actor transform.
+function N.World(_,x,y,z)return x,y,z end
+local localBox=C.LocalBox
